        <mxCell id="G01" data-rules="G01" edge="1" parent="1" source="allactive" style="html=1;rounded=1;curved=0;edgeStyle=none;endArrow=classic;endFill=1;endSize=7;strokeWidth=1.3;strokeColor=#E3434E;fontColor=#202020;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="done" value="对应外部退票单匹配 / 关联成功&lt;br&gt;供应导入，或财务手工建外部单">
