        <mxCell id="done" data-role="state" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9BBEFF;strokeColor=#424242;strokeWidth=1.2;fontColor=#202020;fontFamily=Microsoft YaHei;fontSize=18;spacing=8;" value="来账已完结" vertex="1">
          <mxGeometry height="64" width="200" x="560" y="1350" as="geometry" />
