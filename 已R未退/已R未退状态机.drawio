        <mxCell id="endline" edge="1" parent="1" source="done" style="html=1;rounded=1;curved=0;edgeStyle=none;endArrow=classic;endFill=1;endSize=7;strokeWidth=1.3;strokeColor=#202020;fontColor=#202020;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="end" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="finishnote" data-role="annotation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#424242;strokeWidth=1.2;fontColor=#202020;fontFamily=Microsoft YaHei;fontSize=18;spacing=8;strokeColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#444444;spacing=0;" value="金额对平或存在差异，都交差异单处理；金额一致、资金到账、整批结算均不是本模块完结门槛。&lt;br&gt;实际已退款但无供应账单：仍不能直接完结，须由财务手工建外部单并关联。" vertex="1">
          <mxGeometry height="75" width="1200" x="120" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="timing" data-role="annotation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#424242;strokeWidth=1.2;fontColor=#202020;fontFamily=Microsoft YaHei;fontSize=18;spacing=8;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;" value="首次等待按有效配置计算，催款后每轮等5个自然日。只填日期时以该日结束为界，有时刻时按该时刻判断。&lt;br&gt;本轮催款超时且仍为已催款，系统标记供应反馈异常。供应已回信但处理人尚未登记，也可能触发。" vertex="1">
          <mxGeometry height="65" width="1200" x="120" y="1630" as="geometry" />
        </mxCell>
        <mxCell id="compare_t19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1C354C;strokeColor=#B6CAD9;fillColor=#F4F8FC;spacingLeft=14;spacingRight=12;spacingTop=3;spacingBottom=3;" value="&lt;b&gt;T19　我方定下次核实时间&lt;/b&gt;&lt;br&gt;原承诺11月10日已过，供应商只说“还在审核”。&lt;br&gt;负责人同意继续等，约定11月15日10:00再查。" vertex="1">
          <mxGeometry height="93" width="640" x="45" y="906" as="geometry" />
        </mxCell>
        <mxCell id="compare_t20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1C354C;strokeColor=#B6CAD9;fillColor=#F4F8FC;spacingLeft=14;spacingRight=12;spacingTop=3;spacingBottom=3;" value="&lt;b&gt;T20　供应商给出新的承诺退款时间&lt;/b&gt;&lt;br&gt;原承诺11月10日已过，供应商回信承诺“改为11月15日退款”。&lt;br&gt;负责人接受，登记11月15日为新的承诺退款日。" vertex="1">
          <mxGeometry height="93" width="655" x="715" y="906" as="geometry" />
        </mxCell>
