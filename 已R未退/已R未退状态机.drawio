        <mxCell id="businessnote" data-role="annotation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#424242;strokeWidth=1.2;fontColor=#202020;fontFamily=Microsoft YaHei;fontSize=18;spacing=8;strokeColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#555555;spacing=0;" value="已在商务阶段且无结果 / 明确拒退&lt;br&gt;保持商务升级中，不额外生成流转&lt;br&gt;本期不设“放弃追款”终态" vertex="1">
